      "title": { "ja": "はじめての一閃", "en": "The First Strike" },
      "subtitle": { "ja": "見習い騎手、最初の三戦", "en": "An apprentice's first three races" },
      "races": [
        {
          "id": "c1_debut", "trackId": "aoba_turf_1600", "cpuCount": 5, "cpuLevel": 1, "cpuStatPermille": 800,
          "title": { "ja": "デビュー戦", "en": "Debut" },
          "story": {
            "before": { "ja": "厩舎の朝は早い。相棒の首をなでて、ゲートへ向かう。まずは最後まで走り切ろう。", "en": "Mornings at the stable start early. A pat on your partner's neck, and off to the gate. First, just ride it to the end." },
            "after": { "ja": "鞍を下ろすと、調教師がうなずいた。「悪くない。次は直線の長いコースだ」", "en": "As you unsaddle, the trainer nods. \"Not bad. Next, a course with a longer straight.\"" }
          },
          "clear": { "maxPlace": 3 },
          "reward": { "items": [ { "itemId": "breeding_material", "qty": 1 } ] },
          "stars": [
            { "objective": { "maxPlace": 1 }, "reward": { "items": [ { "itemId": "training_apple", "qty": 1 } ] } },
            { "objective": { "maxPlace": 3, "maxWhips": 3 }, "reward": { "items": [ { "itemId": "training_apple", "qty": 1 } ] } }
          ]
        },
        {
