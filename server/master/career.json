          "title": { "ja": "長い直線", "en": "The Long Straight" },
          "story": {
            "before": { "ja": "直線が長いぶん、ムチを入れる時間もある。焦らず、光るまで待つ。", "en": "A long straight gives you time to use the whip. Stay calm and wait for the glow." },
            "after": { "ja": "最後の一完歩まで脚が残っていた。待てば、馬は応えてくれる。", "en": "There was still something left at the final stride. Wait, and the horse answers." }
          },
          "clear": { "maxPlace": 3 },
          "reward": { "items": [ { "itemId": "breeding_material", "qty": 1 } ] },
          "stars": [
