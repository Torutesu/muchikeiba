{
  "name": "muchi-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:golden": "tsx scripts/gen-golden.ts",
    "gen:assets": "tsx scripts/gen-assets.ts",
    "scan:assets": "tsx scripts/scan-assets.ts",
    "l10n:missing": "tsx scripts/l10n-missing.ts",
    "gen:client-locale": "tsx scripts/gen-client-locale.ts",
    "gen:advice-vectors": "tsx scripts/gen-advice-vectors.ts",
    "gen:help-vectors": "tsx scripts/gen-help-vectors.ts",
    "gen:client-error-vectors": "tsx scripts/gen-client-error-vectors.ts",
    "gen:practice-sample": "tsx scripts/gen-practice-sample.ts",
    "gen:career-sample": "tsx scripts/gen-career-sample.ts",
    "lint:deploy": "tsx scripts/lint-deploy.ts",
    "economy": "tsx scripts/economy.ts",
    "smoke": "tsx scripts/smoke.ts",
    "dev": "wrangler dev --var DEV_MODE:1 --var TICKET_SECRET:devsecret --var ADMIN_TOKEN:dev-admin",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.6",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  }
}
