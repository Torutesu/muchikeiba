<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- The real engine + Unity game layer (Assets/Muchi/Game, no UnityEngine) compiled to WebAssembly for the web prototype. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../engine/Muchi.Engine/Muchi.Engine.csproj" />
    <ProjectReference Include="../../../engine/Muchi.Net/Muchi.Net.csproj" />
    <ProjectReference Include="../../../engine/Muchi.Client/Muchi.Client.csproj" />
    <Compile Include="../../../unity/Assets/Muchi/Game/RaceFactory.cs" Link="Game/RaceFactory.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/RaceInput.cs" Link="Game/RaceInput.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/RaceDrivers.cs" Link="Game/RaceDrivers.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/HudModel.cs" Link="Game/HudModel.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/CommentaryFeed.cs" Link="Game/CommentaryFeed.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/CourseFrame.cs" Link="Game/CourseFrame.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/RaceResultModel.cs" Link="Game/RaceResultModel.cs" />
    <!-- round 9: replay share, account-link prompt, ghost picker (and what they build on) -->
    <Compile Include="../../../unity/Assets/Muchi/Game/ReplayShare.cs" Link="Game/ReplayShare.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/AccountLinkPrompt.cs" Link="Game/AccountLinkPrompt.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/FirebaseAuth.cs" Link="Game/FirebaseAuth.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/GameBackend.cs" Link="Game/GameBackend.cs" />
    <!-- GameBackend (round 8/9): server texts and the game-day rule it installs from GET /v1/config -->
    <Compile Include="../../../unity/Assets/Muchi/Game/UxText.cs" Link="Game/UxText.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/GameDay.cs" Link="Game/GameDay.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/GameSettings.cs" Link="Game/GameSettings.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/ScreenModels.cs" Link="Game/ScreenModels.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/WebSocketTransportFactory.cs" Link="Game/WebSocketTransportFactory.cs" />
    <Compile Include="../../../unity/Assets/Muchi/Game/GachaModels.cs" Link="Game/GachaModels.cs" />
    <!-- round 12: かんたん操作 (AssistModel.Attach / RidingLevel; HudModel reads it) -->
    <Compile Include="../../../unity/Assets/Muchi/Game/AssistModel.cs" Link="Game/AssistModel.cs" />
    <!-- round 15: アクセシビリティ設定 (GameBackend.Accessibility reads the device copy through it) -->
    <Compile Include="../../../unity/Assets/Muchi/Game/AccessibilityModel.cs" Link="Game/AccessibilityModel.cs" />
  </ItemGroup>
</Project>
