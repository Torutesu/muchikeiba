<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Type-checks the MUCHI_FIREBASE build: Assets/Muchi/Integration (Muchi.Unity, incl. FirebaseSdkAuth.cs) and the app
    scripts (Assets/Muchi/Runtime, which call MuchiFirebase at startup) with the define set, against FirebaseStubs.cs —
    stubs of the Firebase Unity SDK 11 auth API this code uses (an assumption of its shape, NOT the real SDK; the
    real check is an Editor/device build with the SDK imported). UnityEngine as in ../UnityAdapters.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Muchi.UnityFirebaseCheck</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0618;CS0649;CS0414</NoWarn>
    <DefineConstants>$(DefineConstants);MUCHI_FIREBASE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Muchi/Integration/**/*.cs" />
    <Compile Include="../../Assets/Muchi/Runtime/**/*.cs" />
    <Compile Include="FirebaseStubs.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Muchi.Game/Muchi.Game.csproj" />
    <PackageReference Include="RocketModFix.UnityEngine.Redist" Version="2022.3.62.3" />
  </ItemGroup>
</Project>
